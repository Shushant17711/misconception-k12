[{"id": "c3bff5a23639", "transcription": "L1 | [photo rotated] = (2^5 x 3^4 x 2^2)/(2^4 x 3^2)\nL2 | = (2^7 x 3^4)/(2^4 x 3^2)\nL3 | = 2^3 x 3^2 = 8 x 9 = 72", "reasoning": "Combines exponents of like bases and gets 8 x 9 = 72, matching the key.", "top3": [["NONE", 0.97], ["NOT-01", 0.02], ["EXP-02", 0.01]]}, {"id": "bcdc45e72a16", "transcription": "L1 | [crossed: 9 + 3 = 12 x p = 12x]\nL2 | 6 x 9 = 54\nL3 | r = 78 ; = 54 + (-78) = -24", "reasoning": "q = -9 is used as +9, so r is taken as -78 to force -24 (r should be 5), and p - q x r = 51 is never computed.", "top3": [["INT-04", 0.5], ["ANS-01", 0.3], ["ALG-04", 0.1]]}, {"id": "556a6c76c050", "transcription": "L1 | [photo rotated] 6 3/4 - 1 1/2 = 27/4 - 3/2 = 27/4 - 6/4 = 21/4\nL2 | 21/4 : 3/8 = 21/4 x 8/3 = 14/1 = 14\nL3 | Jadi dibutuhkan 14 kantong", "reasoning": "Subtracts to 21/4 and divides by 3/8 to get 14 bags, matching the key.", "top3": [["NONE", 0.97], ["NOT-01", 0.02], ["FRA-03", 0.01]]}, {"id": "f08664d1f099", "transcription": "L1 | [blurry] 8 x 6 x 15\nL2 | 8 x 6: 8 + 8 + 8 + 8 + 8 + 8 = 48\nL3 | 48 x 15 = 720\nL4 | 720 - 220 = 500", "reasoning": "Computes 720 pairs and subtracts 220 to get 500, matching the key.", "top3": [["NONE", 0.95], ["NOT-01", 0.04], ["OPS-01", 0.01]]}, {"id": "2047964a5f5f", "transcription": "L1 | Uang0 = 10 000 000 ; Uang2 = 14 400 000\nL2 | 144/100 = 1,44 ; √1,44 = 1,2\nL3 | 10 000 000 x 1,2^4 (tahun 4)\nL4 | 20736 x 10000000 = 2.073600", "reasoning": "Finds the growth factor 1,2 and uses 1,2^4 correctly, but the decimal place of 2,0736 is lost when multiplying, giving 2.073.600 instead of 20.736.000.", "top3": [["Dec-02", 0.75], ["PV-01", 0.15], ["CAL-01", 0.08]]}, {"id": "42747e1d1915", "transcription": "L1 | 6 x 4 = 24\nL2 | 4 x (-2) = -8\nL3 | 0 x (-1) = 0\nL4 | 24 - 8 + 0 = 16", "reasoning": "Scores 6 wins, 4 losses and 0 draws to get 16, matching the key.", "top3": [["NONE", 0.97], ["NOT-01", 0.02], ["INT-04", 0.01]]}, {"id": "73b01b9cc724", "transcription": "L1 | [photo rotated] 2. A = 8 = 8, 16, (24), 32, 40, (48), 56, 64, (72), 80\nL2 | B = 12 = 12, (24), 36, (48), 60, (72), 84, 96, 108, 120\nL3 | = 3 (kali)", "reasoning": "The multiples of 8 stop at 80, so the shared multiples 96 and 120 within 120 seconds are missed, giving 3 instead of 5.", "top3": [["KPF-04", 0.6], ["ANS-01", 0.2], ["KPF-02", 0.12]]}, {"id": "46e8989ced7d", "transcription": "L1 | 100 - 60 : 10 x (-3) = 100 - 60 : -30 = 100 - (-2)\nL2 | Jawab = 102", "reasoning": "10 x (-3) is computed before the division (÷ and × should go left to right), giving 102 instead of 118.", "top3": [["OOO-01", 0.9], ["INT-03", 0.04], ["CAL-01", 0.03]]}]