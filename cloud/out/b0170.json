[{"id": "1e9583e085ed", "transcription": "L1 | 1. 6 + 4\nL2 | 2. 4 + 6\nL3 | 3. 5 + 5\nL4 | 36 : 3 = 12", "reasoning": "The 3 favourable outcomes and 36 total are right, but the ratio is inverted (36 : 3 = 12) instead of 3/36 ≈ 0,083, giving a 'probability' above 1.", "top3": [["PRO-03", 0.5], ["WOP-01", 0.3], ["ANS-01", 0.1]]}, {"id": "8270f33a0777", "transcription": "L1 | 2,45 = 2 45/100 = 2 9/20\nL2 | = 2 9/20 - 1 1/4\nL3 | = 2 9/20 - 1 5/20\nL4 | = 1 4/20 = 1 1/5", "reasoning": "Converts 2,45 to 2 9/20, subtracts with a common denominator and gets 1 1/5 = 6/5, matching the key.", "top3": [["NONE", 0.95], ["NOT-01", 0.03], ["FRA-05", 0.01]]}, {"id": "4b26fbf46910", "transcription": "L1 | (1) (f o g o h)(x) = f(g(h(x))) ; g(h(x)) = (x + 2)^2 = x^2 + 4x + 4\nL2 | f(g(h(x))) = 2(x^2 + 4x + 4) - 1 = 2x^2 + 8x + 7 [written 2x + 8x + 7]\nL3 | (2) f(x) = x + 2 ; h(x) = x^2 - 2 ; (f o g o h)(x) = 2x^2 + 4\nL4 | g(h(x)) + 2 = 2x^2 + 4 ; g(h(x)) = 2x^2 + 2\nL5 | g(x^2 - 2) = 2x^2 + 2 = 2(x^2 - 2) + 6 ; g(x) = 2x + 6", "reasoning": "Peels off f, rewrites 2x^2 + 2 in terms of x^2 - 2 and gets g(x) = 2x + 6, matching the key.", "top3": [["NONE", 0.93], ["NOT-01", 0.04], ["FUN-01", 0.01]]}, {"id": "06506f9bcc54", "transcription": "L1 | 4 x 3 = 12\nL2 | 12 x 5 = 60\nL3 | = -12 + 60\nL4 | = 48 cm", "reasoning": "3 weeks is used as 3 days (4 x 3 instead of 4 x 21 = 84), so the total change is +48 instead of -84 + 60 = -24.", "top3": [["MEA-02", 0.6], ["WOP-01", 0.2], ["CAL-01", 0.1]]}, {"id": "49aa680fa20f", "transcription": "L1 | 3 1/3 = 10/3\nL2 | . 3/5\nL3 | = 10/3 x 3/5 = 30/15 = 5/5 [sic] = 6/3", "reasoning": "Multiplies 10/3 x 3/5 = 30/15 = 2 (written as 6/3), matching the key; the intermediate 5/5 is a stray slip.", "top3": [["NONE", 0.85], ["NOT-01", 0.08], ["ANS-01", 0.04]]}, {"id": "3a6e374fb6bd", "transcription": "L1 | 32 ) 11 = 0,34375\nL2 | 110 - 96 = 14 ; 140 - 128 = 12 ; 120 - 96 = 24 ; 240 - 224 = 16 ; 160 - 160 = 0", "reasoning": "Long division of 11 by 32 gives 0,34375, matching the key.", "top3": [["NONE", 0.97], ["OPS-02", 0.02], ["NOT-01", 0.01]]}, {"id": "efa9246cd411", "transcription": "L1 | Diket: P(x) = 2x + 10 ; k(x) = 6x + 30 ; keliling = 90 m\nL2 | 6x + 30 = 90 ; 6x = 60 ; x = 10\nL3 | P = 2(10) + 10 = 30 m\nL4 | 90 = 2(30 + l) ; 45 = 30 + l ; l = 15\nL5 | L = 30 x 15 = 450 m^2", "reasoning": "Finds x = 10, length 30, width 15 and area 450 m^2, matching the key.", "top3": [["NONE", 0.97], ["NOT-01", 0.02], ["MEA-01", 0.01]]}, {"id": "1f55d48c9274", "transcription": "L1 | -6 x 8 = -48\nL2 | -48 : -4 = 12\nL3 | 12 x -3 = 36", "reasoning": "12 x (-3) is given as +36 instead of -36, applying the wrong sign rule for a positive times a negative.", "top3": [["INT-02", 0.8], ["CAL-01", 0.12], ["INT-04", 0.05]]}]